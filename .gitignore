# Build output
build/
dist/
DerivedData/

# Generated by XcodeGen (source of truth is project.yml)
*.xcodeproj

# Xcode user data
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# macOS
.DS_Store

# Secrets / local env (use op:// references via `op run` — never commit values)
.env
.env.local
*.p12
*.cer
*.provisionprofile

# Misc
*.swp

# Instalador publicado no site — vem do `make dmg`, não versionamos binário
website/download/

# O .env do site guarda só referências op://, então é versionável de propósito
!website/.env

# Originais 2K do Nano Banana Pro (~2 MB cada). O site serve os .webp;
# para refazer: make site-images && python3 website/tools/optimize-images.py
website/assets/img/ritual.png
website/assets/img/spaces.png
website/assets/img/card.png
website/assets/img/footer.png
